<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://surfcontrol.tv/app"
        version="1.0.0"
        viewmodes="maximized">
    <tizen:application id="SurfControl.main" package="SurfControl" required_version="3.0"/>
    <tizen:profile name="tv-samsung"/>
    <name>Surf Control</name>
    <description>Control the Surfshark VPN shard on this TV.</description>
    <author>piecifra</author>
    <content src="index.html"/>
    <icon src="icon.png"/>

    <feature name="http://tizen.org/feature/screen.size.all"/>

    <!-- The Shard's local control bridge, reached via the TV's LAN IP -->
    <access origin="*" subdomains="true"/>
    <tizen:allow-mixed-content>true</tizen:allow-mixed-content>
    <tizen:content-security-policy>default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; connect-src * http://192.168.1.19:18765 http://127.0.0.1:18765</tizen:content-security-policy>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>

    <tizen:setting screen-orientation="landscape"
                   context-menu="disable"
                   background-support="disable"
                   encryption="disable"
                   install-location="auto"
                   hwkey-event="enable"/>
</widget>
